<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+; the same rules as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="device_tier.xml" />
        <exclude domain="sharedpref" path="blocked_pending.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="device_tier.xml" />
        <exclude domain="sharedpref" path="blocked_pending.xml" />
    </device-transfer>
</data-extraction-rules>
