<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Placing and managing calls -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Bluetooth device names in the call's audio menu (a watch and earbuds at once) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Recents and contacts -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- Incoming call screen over the lock screen -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 16 Live Updates: lets skins like OriginOS put the ringing call in their island -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Proximity sensor turns the screen off at the ear during calls -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- No ads: drop the Advertising ID permissions Firebase merges in -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />

    <uses-feature android:name="android.hardware.telephony" android:required="true" />

    <application
        android:label="One Dialer"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true">

        <!-- Main UI: dial pad, recents, contacts -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- tel: and contact intents are read by MainActivity itself; Flutter's own deep
                 linking would push them as named routes the app doesn't have (null-check crash). -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false" />
            <!-- Its launcher icons are the PhoneIcon* aliases below (Settings › App icon, AppIcons.kt). -->
            <!-- Both DIAL filters are required for Android to offer this app as the default dialer -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
            <!-- Other apps show, edit or add a contact here (on the activity, not an icon alias,
                 so switching icons never turns these off). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/contact" />
                <data android:mimeType="vnd.android.cursor.dir/raw_contact" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.INSERT_OR_EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
                <data android:mimeType="vnd.android.cursor.item/raw_contact" />
            </intent-filter>
        </activity>

        <!-- One app, two icons (like vivo's Phone and Contacts); the Contacts one opens on the
             Contacts tab. One pair per style in Settings › App icon (Glossy, Classic), only the chosen pair enabled
             (AppIcons.kt). FlutterActivity reads meta-data from the launched component, so each
             alias needs it too. -->
        <activity-alias android:name=".PhoneIcon" android:targetActivity=".MainActivity"
            android:exported="true" android:label="One Dialer" android:icon="@mipmap/ic_launcher">
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".PhoneIconClassic" android:targetActivity=".MainActivity" android:enabled="false"
            android:exported="true" android:label="One Dialer" android:icon="@mipmap/ic_classic_phone">
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".ContactsLauncher" android:targetActivity=".MainActivity"
            android:exported="true" android:label="One Contacts" android:icon="@mipmap/ic_contacts">
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".ContactsIconClassic" android:targetActivity=".MainActivity" android:enabled="false"
            android:exported="true" android:label="One Contacts" android:icon="@mipmap/ic_classic_contacts">
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Ongoing / incoming call screen; runs on a pre-warmed Flutter engine -->
        <activity
            android:name=".InCallActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity="com.syedarhamraza.dialer.incall"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/InCallTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true" />

        <!-- Telecom binds to this for every call once the app holds the dialer role -->
        <service
            android:name=".telecom.DialerInCallService"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            android:exported="true">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <!-- IN_CALL_SERVICE_RINGING is omitted on purpose: Telecom plays the ringtone and
                 vibration. Set it to true only once the app plays its own ringtone. -->
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- Telecom binds the default dialer's screening service for incoming calls -->
        <service
            android:name=".telecom.DialerScreeningService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".telecom.CallActionReceiver"
            android:exported="false" />

        <!-- Keeps a launcher icon after an update (AppIcons.repair). -->
        <receiver android:name=".AppIconsRepairReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Telecom sends this to the default dialer; content comes from the call log, not extras -->
        <receiver
            android:name=".telecom.MissedCallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.action.SHOW_MISSED_CALLS_NOTIFICATION" />
            </intent-filter>
        </receiver>

        <!-- Firebase Analytics without the advertising ID or ad signals (the AD_ID permissions are removed above). -->
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <!-- Messaging apps shown on the contact page (their icons need package visibility) -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <!-- Google Meet, for the call screen's Video button -->
        <package android:name="com.google.android.apps.tachyon" />
        <!-- One Dialer Recorder, the sideloaded companion that records calls (telecom/RecorderCompanion.kt) -->
        <package android:name="com.syedarhamraza.onedialer.recorder" />
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- The text-to-speech engine, for Announce incoming calls -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
