<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One Dialer's light page from the first frame, dark status bar icons (values-night: black). -->
    <style name="Recorder" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:colorBackground">@color/page</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <color name="page">#F2F3F5</color>
</resources>
