<?xml version="1.0" encoding="utf-8"?>
<!-- One Dialer Recorder: sideloaded companion. Holds the mic and an empty accessibility service so
     One Dialer (the Play app) can record calls without carrying either. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Setup's Battery row: asks to stay out of battery optimisation so the service isn't stopped. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- hasSigningCertificate on One Dialer needs to see it. -->
    <queries>
        <package android:name="com.syedarhamraza.onedialer" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".SetupActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".RecorderAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/recorder_accessibility" />
        </service>

        <!-- Exported for One Dialer's call(); every method checks its signing certificate. -->
        <provider
            android:name=".RecordingsProvider"
            android:authorities="com.syedarhamraza.onedialer.recorder.recordings"
            android:exported="true" />

        <!-- Hands the player or share target one file through a URI grant. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/recording_paths" />
        </provider>
    </application>
</manifest>
